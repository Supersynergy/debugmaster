    "node_modules",
    "target",
    "dist",
    "build",
    ".venv",
    "venv",
    "__pycache__",
    "vendor",
    "vendors",
    "data",
    "claude-code-ui",
}
MAX_SCAN_FILES = int(os.environ.get("DEBUGMASTER_MAX_SCAN_FILES", "120000"))
MAX_SHELLCHECK_FILES = int(os.environ.get("DEBUGMASTER_MAX_SHELLCHECK_FILES", "40"))
