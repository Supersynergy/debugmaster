#!/usr/bin/env python3
"""Debugmaster standalone debug orchestrator.

It uses grepgod when available, but keeps a local fallback for repo health,
catalog lookup, and Codex briefs. The goal is one entrypoint for "debug anything"
without forcing every future workflow into grepgod.
"""

from __future__ import annotations

import argparse
import json
import os
import random
import shutil
import subprocess
import sys
import time
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]
if str(ROOT) not in sys.path:
    sys.path.insert(0, str(ROOT))  # make the lib/ analysis package importable
CATALOG = ROOT / "debugger-engines.json"
TOOLS = ROOT / "tools.json"
REPORTS = ROOT / "reports"
TEMPLATES = ROOT / "templates"
GENERATED_DIRS = {".git", ".grepgod", ".codegraph", ".debugmaster", ".repovista"}
