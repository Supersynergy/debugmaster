    print(json.dumps(_learn.stats(repo), indent=2))
    return 0


def cmd_scan_bugs(args) -> int:
    from lib import bizlogic as _biz
    from lib import bughunt as _bh
    from lib import hunt as _hunt
    repo = Path(args.repo).expanduser().resolve()
    only = None
    if args.dirty:
        only = set(_hunt.git_changed(repo))
    langs = set(args.lang.split(",")) if args.lang else None
    findings = _bh.scan_repo(repo, langs=langs, only_files=only)
    findings += _biz.scan_repo(repo, only_files=only)  # business-logic engine
    if args.cls:
        findings = [f for f in findings if args.cls in f.rule_id]
    findings.sort(key=lambda f: (-_hunt.common.SEVERITY_RANK.get(f.severity, 0), f.file, f.line))
    by_sev = {}
    for f in findings:
        by_sev[f.severity] = by_sev.get(f.severity, 0) + 1
    print(json.dumps({"total": len(findings), "by_severity": by_sev,
                      "findings": [f.as_dict() for f in findings[: args.limit]]}, indent=2))
    return 0 if not any(f.severity in ("critical", "high") for f in findings) else 1


def cmd_doctor(args) -> int:
    from lib import doctor as _doctor
    print(json.dumps(_doctor.audit(), indent=2))
    return 0


def cmd_mcp(args) -> int:
    from lib import mcp_server
    return mcp_server.serve()


def cmd_checks(args) -> int:
    from lib import bizcatalog
    if args.stats:
        print(json.dumps(bizcatalog.stats(), indent=2))
        return 0
    rows = bizcatalog.query(args.query, domain=args.domain or None,
                            kind=args.kind or None, detected=args.detected)
    if args.json:
        print(json.dumps(rows[: args.limit], indent=2))
        return 0
    for r in rows[: args.limit]:
        flag = f"🤖 {r['detector']}" if r["detector"] else r["search"]
        print(f"{r['name']:42} {r['domain']:13} {r['kind']:9} {flag}")
    print(f"\n# {len(rows)} checks (of 200) · {sum(1 for r in rows if r['detector'])} auto-detected by hunt",
          file=sys.stderr)
    return 0


def cmd_watch(args) -> int:
    from lib import flows as _flows
    repo = Path(args.repo).expanduser().resolve()
    try:
        _flows.watch(repo, interval=args.interval)
    except KeyboardInterrupt:
        print("\n# stopped", file=sys.stderr)
    return 0


def cmd_regress(args) -> int:
    from lib import flows as _flows
    repo = Path(args.repo).expanduser().resolve()
    res = _flows.regress(repo, args.file, args.rule_id, line=args.line)
    print(json.dumps(res, indent=2))
    return 0 if res.get("ok") else 1


def cmd_profile(args) -> int:
    from lib import profile as _profile
    cmd = list(args.cmd or [])
    if cmd and cmd[0] == "--":
        cmd = cmd[1:]
    if cmd:
        r = _profile.profile_command(cmd, interval=args.interval,
                                     max_seconds=args.max_seconds, sample_fds=not args.no_fds)
    elif args.pid:
        r = _profile.profile_pid(args.pid, duration=args.duration,
                                 interval=args.interval, sample_fds=not args.no_fds)
    else:
        print("profile: give a command after `--`, or --pid <N>", file=sys.stderr)
        return 2
    if args.json:
        print(json.dumps(r, indent=2))
    else:
        print(_profile.markdown(r))
    return 0 if r.get("verdict") == "CLEAN" else 1


def cmd_audit(args) -> int:
    from lib import audit as _audit
    repo = Path(args.repo).expanduser().resolve()
    out_dir = Path(args.out).expanduser().resolve() if args.out else REPORTS / repo.name
    a = _audit.audit(repo, profile=args.profile, fuse=not args.no_fuse,
                     timeout=args.timeout, save_baseline=args.save_baseline)
    _audit.write(a, out_dir)
    if args.json:
        print(json.dumps(a, indent=2))
    else:
        print(_audit.markdown(a))
    print(f"\n# reports → {out_dir}/debugmaster-audit.{{md,json}}", file=sys.stderr)
    return 0 if a["release_readiness"] == "SHIP" else 1


def cmd_review(args) -> int:
    from lib import flows as _flows
    repo = Path(args.repo).expanduser().resolve()
    res = _flows.review(repo, base=args.base or None, profile=args.profile,
                        timeout=args.timeout, fuse=not args.no_fuse)
    if args.comment:
        body = _flows.review_comment_markdown(res)
        posted = _flows.post_pr_comment(repo, body, pr=args.pr or None)
        res["comment_posted"] = posted
        if not posted.get("posted"):
            print(body, file=sys.stderr)  # so it isn't lost when no gh/glab
    print(json.dumps(res, indent=2))
    return 0 if res["decision"] != "REQUEST-CHANGES" else 1


def cmd_bisect(args) -> int:
    from lib import flows as _flows
    repo = Path(args.repo).expanduser().resolve()
    res = _flows.bisect(repo, args.good, args.bad, args.test, timeout=args.timeout)
    print(json.dumps(res, indent=2))
    return 0 if res.get("ok") else 1


def cmd_explain(args) -> int:
    from lib import flows as _flows
    repo = Path(args.repo).expanduser().resolve()
    trace = sys.stdin.read() if args.trace == "-" else args.trace
    print(json.dumps(_flows.explain(repo, trace), indent=2))
    return 0


def cmd_fix_verify(args) -> int:
    from lib import flows as _flows
    repo = Path(args.repo).expanduser().resolve()
    res = _flows.fix_verify(repo, args.file, args.rule_id, line=args.line)
    print(json.dumps(res, indent=2))
    return 0 if res["fixed"] else 1


def cmd_install_hooks(args) -> int:
    from lib import flows as _flows
    repo = Path(args.repo).expanduser().resolve()
    res = _flows.install_hooks(repo)
    print(json.dumps(res, indent=2))
    return 0 if res.get("ok") else 1


def main() -> int:
    ap = argparse.ArgumentParser(prog="debugmaster")
    sub = ap.add_subparsers(dest="cmd", required=True)

    hunt_p = sub.add_parser("hunt", help="find the smallest hidden bugs, ranked by impact")
    hunt_p.add_argument("repo", nargs="?", default=".")
    hunt_p.add_argument("--out", default="")
    hunt_p.add_argument("--profile", choices=["fast", "deep"], default="fast")
    hunt_p.add_argument("--no-fuse", action="store_true", help="skip external scanners")
    hunt_p.add_argument("--dirty", action="store_true", help="scan only git-dirty files")
    hunt_p.add_argument("-n", "--limit", type=int, default=25)
    hunt_p.add_argument("--scan-limit", type=int, default=6000)
    hunt_p.add_argument("--timeout", type=int, default=90)
    hunt_p.add_argument("--no-record", action="store_true", help="do not persist findings to learn.db")
    hunt_p.add_argument("--no-cache", action="store_true", help="ignore the clean-HEAD report cache")
    hunt_p.add_argument("--triage", action="store_true", help="LLM second-opinion (local Ollama) on top suspects: real vs false-positive")
    hunt_p.add_argument("--triage-n", type=int, default=10, help="how many top suspects to triage")
    hunt_p.add_argument("--json", action="store_true")
    hunt_p.set_defaults(func=cmd_hunt)

    fuse_p = sub.add_parser("fusion", help="run + normalize all installed scanners")
    fuse_p.add_argument("repo", nargs="?", default=".")
    fuse_p.add_argument("--profile", choices=["fast", "deep"], default="fast")
    fuse_p.add_argument("--timeout", type=int, default=90)
    fuse_p.add_argument("-n", "--limit", type=int, default=40)
    fuse_p.set_defaults(func=cmd_fusion)

    lf = sub.add_parser("learn-feedback", help="confirm/dismiss a finding to teach the ranker")
    lf.add_argument("file")
    lf.add_argument("line", type=int)
    lf.add_argument("rule_id")
    lf.add_argument("verdict", help="real|fake")
    lf.add_argument("--repo", default=".")
    lf.set_defaults(func=cmd_learn_feedback)

    ls = sub.add_parser("learn-stats", help="show learned per-rule precision")
    ls.add_argument("--repo", default=".")
    ls.set_defaults(func=cmd_learn_stats)

    sb = sub.add_parser("scan-bugs", help="fast static hidden-bug scan (no fusion/history)")
    sb.add_argument("repo", nargs="?", default=".")
    sb.add_argument("--dirty", action="store_true", help="scan only git-dirty files")
    sb.add_argument("--lang", default="", help="comma list, e.g. python,rust,go")
    sb.add_argument("--class", dest="cls", default="", help="filter rule_id substring, e.g. secret")
    sb.add_argument("-n", "--limit", type=int, default=100)
    sb.set_defaults(func=cmd_scan_bugs)

    doc = sub.add_parser("doctor", help="capability self-audit: which hunt layers are live")
    doc.set_defaults(func=cmd_doctor)

    mcp = sub.add_parser("mcp", help="run as an MCP server (stdio) — exposes hunt/audit/review/explain/profile as agent tools")
    mcp.set_defaults(func=cmd_mcp)

    ck = sub.add_parser("checks", help="business-debug catalog: 200 revenue/billing failure surfaces as ready searches + mapped detectors")
    ck.add_argument("query", nargs="?")
    ck.add_argument("--domain", default="", help="payments|billing|invoice|subscription|refunds|checkout|ledger|tax|pricing|fulfillment|fraud|customer|revenue|webhook")
    ck.add_argument("--kind", default="", choices=["", "product", "primitive"])
    ck.add_argument("--detected", action="store_true", help="only checks debugmaster auto-detects")
    ck.add_argument("--stats", action="store_true", help="counts by domain + detector coverage")
    ck.add_argument("-n", "--limit", type=int, default=60)
    ck.add_argument("--json", action="store_true")
    ck.set_defaults(func=cmd_checks)

    wt = sub.add_parser("watch", help="re-scan changed files on every save (Ctrl-C to stop)")
    wt.add_argument("repo", nargs="?", default=".")
    wt.add_argument("--interval", type=float, default=2.0)
    wt.set_defaults(func=cmd_watch)

    rg = sub.add_parser("regress", help="generate a runnable pytest that locks a confirmed finding as fixed")
    rg.add_argument("file")
    rg.add_argument("rule_id")
    rg.add_argument("line", nargs="?", type=int, default=0)
    rg.add_argument("--repo", default=".")
    rg.set_defaults(func=cmd_regress)

    pf = sub.add_parser("profile", help="runtime diagnostician: memory/fd/thread/gpu leaks, cpu bottlenecks, orphan processes")
    pf.add_argument("--pid", type=int, help="attach to a running pid's process tree")
    pf.add_argument("--duration", type=int, default=20, help="seconds to sample in --pid mode")
    pf.add_argument("--interval", type=float, default=0.5, help="sample interval seconds")
    pf.add_argument("--max-seconds", type=int, default=900, help="cap on command-mode runtime")
    pf.add_argument("--no-fds", action="store_true", help="skip file-descriptor sampling (faster)")
    pf.add_argument("--json", action="store_true")
    pf.add_argument("cmd", nargs=argparse.REMAINDER, help="-- <command to run and profile>")
    pf.set_defaults(func=cmd_profile)

    au = sub.add_parser("audit", help="super-audit: graded whole-repo health verdict + release readiness + trend")
    au.add_argument("repo", nargs="?", default=".")
    au.add_argument("--out", default="")
    au.add_argument("--profile", choices=["fast", "deep"], default="fast")
    au.add_argument("--no-fuse", action="store_true", help="skip external scanners")
    au.add_argument("--timeout", type=int, default=90)
    au.add_argument("--save-baseline", action="store_true", help="store this audit as the trend baseline")
    au.add_argument("--json", action="store_true")
    au.set_defaults(func=cmd_audit)

    rv = sub.add_parser("review", help="is this change safe? hunt scoped to the diff, PR verdict")
    rv.add_argument("repo", nargs="?", default=".")
    rv.add_argument("--base", default="", help="base ref (e.g. main); default = working-tree changes")
    rv.add_argument("--profile", choices=["fast", "deep"], default="fast")
    rv.add_argument("--no-fuse", action="store_true", help="skip external scanners")
    rv.add_argument("--timeout", type=int, default=90)
    rv.add_argument("--comment", action="store_true", help="post the verdict as a PR/MR comment (gh/glab)")
    rv.add_argument("--pr", default="", help="PR/MR number (default: current branch's PR)")
    rv.set_defaults(func=cmd_review)

    bi = sub.add_parser("bisect", help="auto git-bisect a test command to the first bad commit")
    bi.add_argument("repo", nargs="?", default=".")
    bi.add_argument("--good", required=True, help="known-good ref")
    bi.add_argument("--bad", required=True, help="known-bad ref")
    bi.add_argument("--test", required=True, help="command that exits non-zero on the bug")
    bi.add_argument("--timeout", type=int, default=600)
    bi.set_defaults(func=cmd_bisect)

    ex = sub.add_parser("explain", help="localize a stacktrace into the repo + show suspects")
    ex.add_argument("trace", nargs="?", default="-", help="stacktrace text, or - for stdin")
    ex.add_argument("--repo", default=".")
    ex.set_defaults(func=cmd_explain)

    fv = sub.add_parser("fix-verify", help="run a finding's verify command, re-scan, auto-learn on pass")
    fv.add_argument("file")
    fv.add_argument("rule_id")
    fv.add_argument("line", nargs="?", type=int, default=0)
    fv.add_argument("--repo", default=".")
    fv.set_defaults(func=cmd_fix_verify)

    ih = sub.add_parser("install-hooks", help="install a pre-commit gate that runs review")
    ih.add_argument("repo", nargs="?", default=".")
    ih.set_defaults(func=cmd_install_hooks)

    scan = sub.add_parser("scan")
    scan.add_argument("repos", nargs="*")
    scan.set_defaults(func=cmd_scan)

    repo = sub.add_parser("repo")
    repo.add_argument("repo")
    repo.add_argument("--full", action="store_true")
    repo.set_defaults(func=cmd_repo)

    risk = sub.add_parser("top-risk")
    risk.add_argument("repo", nargs="?", default=".")
    risk.add_argument("-n", "--limit", type=int, default=20)
    risk.set_defaults(func=cmd_top_risk)

    brief = sub.add_parser("codex-brief")
    brief.add_argument("repo", nargs="?", default=".")
    brief.add_argument("-n", "--limit", type=int, default=12)
    brief.set_defaults(func=cmd_codex_brief)

    catalog = sub.add_parser("catalog")
    catalog.add_argument("query", nargs="?")
    catalog.add_argument("-n", "--limit", type=int, default=30)
    catalog.set_defaults(func=cmd_catalog)

    engines = sub.add_parser("engines")
    engines.set_defaults(func=cmd_engines)

    flows = sub.add_parser("flows")
    flows.add_argument("--json", action="store_true")
    flows.set_defaults(func=cmd_flows)

    init = sub.add_parser("init")
    init.add_argument("--link", action="store_true", help="symlink debugmaster into ~/.local/bin")
    init.set_defaults(func=cmd_init)

    ei = sub.add_parser("engines-install", help="install the optional best-in-class engine stack (biome, golangci-lint, py-spy, delve, …)")
    ei.add_argument("--yes", "-y", action="store_true", help="install without prompting")
    ei.add_argument("--dry-run", action="store_true", help="print the plan, install nothing")
    ei.add_argument("--list", action="store_true", help="list groups + tools, then exit")
    ei.add_argument("--only", default="", help="comma-separated groups: fusion,js,go,rust,python-debug,native,llm,ml")
    ei.set_defaults(func=cmd_engines_install)

    autofix = sub.add_parser("autofix", help="plan or apply safe low-risk fixes")
    autofix.add_argument("repo", nargs="?", default=".")
    autofix.add_argument("--apply", action="store_true", help="apply safe fixes; default is dry-run")
    autofix.set_defaults(func=cmd_autofix)

    mine = sub.add_parser("mine", help="use ghmax to mine reference repos and patterns")
    mine.add_argument("repo", nargs="?", default=".")
    mine.add_argument("--query", default="")
    mine.add_argument("--out", default="")
    mine.add_argument("-n", "--limit", type=int, default=8)
    mine.set_defaults(func=cmd_mine)

    batch = sub.add_parser("batch", help="scan many repos and write aggregate reports")
    batch.add_argument("repos", nargs="*")
    batch.add_argument("--root", default=".")
    batch.add_argument("--out", default="")
    batch.add_argument("--limit", type=int, default=5)
    batch.add_argument("--random", action="store_true")
    batch.add_argument("--timeout", type=int, default=60)
    batch.add_argument("--no-checks", action="store_true")
    batch.add_argument("--security", dest="no_security", action="store_false", help="run optional security scan")
    batch.add_argument("--no-security", dest="no_security", action="store_true", help="skip optional security scan")
    batch.set_defaults(no_security=True)
    batch.add_argument("--full-map", action=argparse.BooleanOptionalAction, default=False)
    batch.add_argument("--ghmax", action="store_true")
    batch.add_argument("--ghmax-query", default="")
    batch.add_argument("--check-profile", choices=["safe", "standard", "deep"], default="safe")
    batch.set_defaults(func=cmd_batch)

    ci = sub.add_parser("init-ci", help="install GitHub Actions PR report workflow into a repo")
    ci.add_argument("repo", nargs="?", default=".")
    ci.add_argument("--force", action="store_true")
    ci.set_defaults(func=cmd_init_ci)

    all_cmd = sub.add_parser("all")
    all_cmd.add_argument("repo", nargs="?", default=".")
    all_cmd.add_argument("--out", default="")
    all_cmd.add_argument("--timeout", type=int, default=120)
    all_cmd.add_argument("--no-checks", action="store_true")
    all_cmd.add_argument("--security", dest="no_security", action="store_false", help="run optional security scan")
    all_cmd.add_argument("--no-security", dest="no_security", action="store_true", help="skip optional security scan")
    all_cmd.set_defaults(no_security=True)
    all_cmd.add_argument("--full-map", action=argparse.BooleanOptionalAction, default=False)
    all_cmd.add_argument("--ghmax", action="store_true", help="mine ghmax reference repos and pattern hits")
    all_cmd.add_argument("--ghmax-query", default="")
    all_cmd.add_argument("--check-profile", choices=["safe", "standard", "deep"], default="safe")
    all_cmd.set_defaults(func=cmd_all)

    args = ap.parse_args()
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
